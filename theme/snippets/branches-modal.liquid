{%- comment -%}
  ORDON EGYPT — Branches Locator Modal (Ozar Minimal Style)
{%- endcomment -%}

<div id="branches-modal" class="modal-backdrop" data-branches-close>
  <div class="bg-white border border-[#e5e5e5] rounded-lg max-w-lg w-full p-5 shadow-2xl relative text-right" onclick="event.stopPropagation()">
    <button type="button" class="absolute top-4 left-4 text-[#777777] hover:text-[#111111] p-1" data-branches-close aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <div class="mb-4">
      <span class="text-[10px] font-mono uppercase text-[#777777] font-bold">DELTA BRANCHES</span>
      <h3 class="text-lg font-black uppercase text-[#111111]">فروع ORDON الرسمية</h3>
      <p class="text-xs text-[#555555] mt-1">تشرفنا بزيارتك لتجربة Sizeات والخامات مباشرة في المحافظات:</p>
    </div>

    <div class="space-y-3">
      <!-- Tanta -->
      <div class="p-3 bg-[#fafafa] border border-[#e5e5e5] rounded flex items-center justify-between">
        <div>
          <h4 class="font-bold text-xs text-[#111111]">فرع Tanta (الرئيسي)</h4>
          <p class="text-[11px] text-[#777777]">شارع النحاس، تقاطع الفاتح</p>
        </div>
        <a href="https://maps.google.com/?q=30.799368,31.000240" target="_blank" rel="noopener" class="px-3 py-1 bg-white border border-[#111111] text-[11px] font-bold rounded hover:bg-[#111111] hover:text-white transition-colors">
          اللوكيشن &larr;
        </a>
      </div>

      <!-- El-Mahallah -->
      <div class="p-3 bg-[#fafafa] border border-[#e5e5e5] rounded flex items-center justify-between">
        <div>
          <h4 class="font-bold text-xs text-[#111111]">فرع El-Mahalla El-Kubra</h4>
          <p class="text-[11px] text-[#777777]">Shukri Al-Qawatli Street، أمام البنك الأهلي</p>
        </div>
        <a href="https://maps.google.com/?q=30.977278,31.172014" target="_blank" rel="noopener" class="px-3 py-1 bg-white border border-[#111111] text-[11px] font-bold rounded hover:bg-[#111111] hover:text-white transition-colors">
          اللوكيشن &larr;
        </a>
      </div>

      <!-- Kafr El-Sheikh -->
      <div class="p-3 bg-[#fafafa] border border-[#e5e5e5] rounded flex items-center justify-between">
        <div>
          <h4 class="font-bold text-xs text-[#111111]">فرع Kafr El-Sheikh</h4>
          <p class="text-[11px] text-[#777777]">شارع المحكمة، بجوار المحطة</p>
        </div>
        <a href="https://maps.google.com/?q=31.114029,30.945383" target="_blank" rel="noopener" class="px-3 py-1 bg-white border border-[#111111] text-[11px] font-bold rounded hover:bg-[#111111] hover:text-white transition-colors">
          اللوكيشن &larr;
        </a>
      </div>
    </div>
  </div>
</div>
