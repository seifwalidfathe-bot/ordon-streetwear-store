{%- comment -%}
  ORDON EGYPT — Cart Drawer Snippet (Ozar Minimal Style)
{%- endcomment -%}

<div id="cart-drawer-overlay" class="cart-drawer-backdrop" data-cart-close></div>

<aside id="cart-drawer" class="cart-drawer-panel" aria-label="Shopping Bag">
  <!-- Header -->
  <div class="p-4 border-b border-[#e5e5e5] flex items-center justify-between bg-white">
    <div class="flex items-center gap-2">
      <h3 class="font-black text-sm uppercase tracking-wider text-[#111111]">SHOPPING BAG</h3>
      <span class="cart-count-badge px-2 py-0.5 bg-[#f3f3f3] text-[#111111] text-[10px] font-mono font-bold rounded">
        {{ cart.item_count }} ITEMS
      </span>
    </div>
    <button type="button" class="text-[#777777] hover:text-[#111111] p-1.5" data-cart-close aria-label="Close Bag">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <!-- Free Shipping Progress Bar (Black minimal fill) -->
  <div class="p-3.5 bg-[#fafafa] border-b border-[#e5e5e5]">
    <div class="flex items-center justify-between text-[11px] font-mono font-bold mb-1.5" id="cart-shipping-msg">
      <span>Free Shipping عند الوصول لـ 2,000 ج.م</span>
    </div>
    <div class="w-full h-1.5 bg-[#e5e5e5] rounded-full overflow-hidden">
      <div id="cart-shipping-bar" class="h-full bg-[#111111] transition-all duration-300" style="width: 0%;"></div>
    </div>
  </div>

  <!-- Cart Items List -->
  <div class="flex-grow overflow-y-auto p-4 space-y-3" id="cart-drawer-items">
    {%- if cart.item_count == 0 -%}
      <div class="h-64 flex flex-col items-center justify-center text-center p-6 text-[#777777]">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-2 text-[#cccccc]">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <p class="text-xs font-bold text-[#111111]">Your shopping bag is empty حالياً</p>
        <p class="text-[11px] text-[#777777] mt-1">تصفح القطع واطلب مقاسك المفضل</p>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="p-3 bg-[#fafafa] border border-[#e5e5e5] rounded flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title }}" class="w-14 h-16 object-cover rounded bg-white border border-[#e5e5e5]">
            <div>
              <h4 class="text-xs font-bold uppercase text-[#111111] line-clamp-1">{{ item.product.title }}</h4>
              <div class="text-[10px] text-[#777777] font-mono mt-0.5">SIZE: <span class="font-bold text-[#111111]">{{ item.variant.title }}</span></div>
              <div class="text-xs font-mono font-bold text-[#111111] mt-0.5">{{ item.final_line_price | money_with_currency }}</div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex items-center border border-[#e5e5e5] rounded bg-white">
              <button type="button" class="px-2 py-0.5 text-xs text-[#777777] hover:text-black font-bold" data-cart-update="{{ item.key }}" data-cart-qty="{{ item.quantity | minus: 1 }}">-</button>
              <span class="px-1.5 text-xs font-mono font-bold">{{ item.quantity }}</span>
              <button type="button" class="px-2 py-0.5 text-xs text-[#777777] hover:text-black font-bold" data-cart-update="{{ item.key }}" data-cart-qty="{{ item.quantity | plus: 1 }}">+</button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <!-- Footer -->
  <div class="p-4 bg-white border-t border-[#e5e5e5] space-y-3">
    <div class="flex items-baseline justify-between text-[#111111]">
      <span class="text-xs font-bold uppercase">SUBTOTAL:</span>
      <span class="text-base font-mono font-black" id="cart-drawer-total">{{ cart.total_price | money_with_currency }}</span>
    </div>

    <div class="space-y-2">
      <a href="/checkout" class="w-full block text-center py-3 bg-[#111111] hover:bg-[#333333] text-white text-xs font-bold uppercase tracking-wider rounded transition-colors">
        PROCEED TO CHECKOUT
      </a>

      <a
        id="cart-whatsapp-order"
        href="https://wa.me/201065052442"
        target="_blank"
        rel="noopener"
        class="w-full py-2.5 px-3 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-800 text-xs font-bold rounded flex items-center justify-center gap-2 transition-colors"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>
        <span>طلب سريع عبر WhatsApp (WhatsApp Fast Order)</span>
      </a>
    </div>
  </div>
</aside>
