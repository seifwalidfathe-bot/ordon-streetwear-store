{%- comment -%}
  ORDON EGYPT — Size Guide Modal (Ozar Minimal Style)
{%- endcomment -%}

<div id="size-modal" class="modal-backdrop" data-size-close>
  <div class="bg-white border border-[#e5e5e5] rounded-lg max-w-md w-full p-5 shadow-2xl relative text-right" onclick="event.stopPropagation()">
    <button type="button" class="absolute top-4 left-4 text-[#777777] hover:text-[#111111] p-1" data-size-close aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <div class="mb-4">
      <span class="text-[10px] font-mono uppercase text-[#777777] font-bold">FIT GUIDE</span>
      <h3 class="text-lg font-black uppercase text-[#111111]">دليل Sizeات المعتمد</h3>
      <p class="text-xs text-[#555555] mt-1">قصاتنا مصممة Boxy Oversized عصرية. اختر مقاسك المعتاد للحصول على مظهر فضفاض مريح.</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-xs text-[#111111] border-collapse font-mono">
        <thead>
          <tr class="border-b border-[#e5e5e5] text-[#777777] font-bold text-right">
            <th class="py-2">Size</th>
            <th class="py-2">الصدر</th>
            <th class="py-2">الطول</th>
            <th class="py-2">الوزن التقريبي</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#e5e5e5]">
          <tr>
            <td class="py-2 font-bold">Medium (M)</td>
            <td class="py-2">118 سم</td>
            <td class="py-2">72 سم</td>
            <td class="py-2 text-[#777777]">55 - 70 كجم</td>
          </tr>
          <tr>
            <td class="py-2 font-bold">Large (L)</td>
            <td class="py-2">124 سم</td>
            <td class="py-2">75 سم</td>
            <td class="py-2 text-[#777777]">70 - 85 كجم</td>
          </tr>
          <tr>
            <td class="py-2 font-bold">X-Large (XL)</td>
            <td class="py-2">130 سم</td>
            <td class="py-2">78 سم</td>
            <td class="py-2 text-[#777777]">85 - 100 كجم</td>
          </tr>
          <tr>
            <td class="py-2 font-bold">2X-Large (2XL)</td>
            <td class="py-2">136 سم</td>
            <td class="py-2">81 سم</td>
            <td class="py-2 text-[#777777]">100 - 118 كجم</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
