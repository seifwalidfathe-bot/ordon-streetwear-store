{%- comment -%}
  ORDON EGYPT — Main Product Template Section
  High-conversion product page tailored for Egyptian streetwear
{%- endcomment -%}

<section class="py-12 bg-[#08090d] text-slate-100 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono mb-8" aria-label="مسار التصفح">
      <a href="/" class="hover:text-sky-400">Home</a>
      <span>/</span>
      <a href="/collections/all" class="hover:text-sky-400">الكولكشن</a>
      <span>/</span>
      <span class="text-slate-300">{{ product.title }}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Media Gallery -->
      <div class="space-y-4">
        <div class="rounded-2xl overflow-hidden border border-slate-800 bg-[#10131a] aspect-[4/5] shadow-2xl relative">
          {%- if product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 1000 }}"
              alt="{{ product.title | escape }}"
              class="w-full h-full object-cover"
              id="main-product-image"
            >
          {%- else -%}
            <div class="w-full h-full flex items-center justify-center text-slate-600 font-mono">
              ORDON MEDIA
            </div>
          {%- endif -%}

          <div class="absolute top-4 left-4 rtl:left-auto rtl:right-4 flex flex-col gap-2 z-10">
            <span class="ice-badge backdrop-blur"><span class="pulse-dot"></span> CHILLY DROP</span>
          </div>
        </div>

        {%- if product.media.size > 1 -%}
          <div class="grid grid-cols-4 gap-3">
            {%- for media in product.media limit: 4 -%}
              <button
                type="button"
                class="rounded-lg overflow-hidden border border-slate-800 hover:border-sky-400 aspect-square transition-all"
                onclick="document.getElementById('main-product-image').src='{{ media | image_url: width: 1000 }}'"
              >
                <img src="{{ media | image_url: width: 250 }}" alt="ORDON Angle" class="w-full h-full object-cover" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Buy Column -->
      <div class="flex flex-col space-y-6">
        <div>
          <div class="flex items-center justify-between text-xs text-slate-400 font-mono mb-2">
            <span>{{ product.type | default: 'WINTER STREETWEAR' }}</span>
            <span class="text-sky-400 font-bold">420 GSM ميلتون قطن</span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-display font-black text-white uppercase tracking-tight">
            {{ product.title }}
          </h1>

          <!-- Price Display -->
          <div class="mt-4 flex items-baseline gap-3">
            <span class="text-3xl font-display font-black text-sky-400">
              {{ product.price | money }}
            </span>
            {%- if product.compare_at_price > product.price -%}
              <span class="text-lg text-slate-500 line-through">
                {{ product.compare_at_price | money }}
              </span>
              <span class="bg-rose-500/20 text-rose-400 border border-rose-500/30 text-xs font-mono font-bold px-2 py-0.5 rounded">
                وفر {{ product.compare_at_price | minus: product.price | money }}
              </span>
            {%- endif -%}
          </div>
        </div>

        <!-- Size Selector -->
        <div class="space-y-3 pt-4 border-t border-slate-800">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-200">اختر Size (Oversized Cut):</span>
            <button type="button" data-size-trigger class="text-xs text-sky-400 hover:underline flex items-center gap-1 font-mono font-bold">
              <span>جدول Sizeات الدقيق &rarr;</span>
            </button>
          </div>

          <div class="flex flex-wrap gap-2.5" id="product-size-chips">
            <button type="button" class="size-chip" data-size="M">Medium (M)</button>
            <button type="button" class="size-chip selected" data-size="L">Large (L)</button>
            <button type="button" class="size-chip" data-size="XL">X-Large (XL)</button>
            <button type="button" class="size-chip" data-size="2XL">2X-Large (2XL)</button>
          </div>
          <p class="text-[11px] text-slate-400 font-mono">
            💡 الموديل في الصورة طوله 182 سم ووزنه 78 كجم وبيلبس مقاس L.
          </p>
        </div>

        <!-- Add to Cart & Fast Checkout -->
        <div class="space-y-3 pt-4">
          <button
            type="button"
            class="btn-chilly-primary w-full py-4 text-base font-bold shadow-xl"
            data-quick-add
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ product.price | divided_by: 100.0 }}"
            data-product-image="{{ product.featured_media | image_url: width: 250 }}"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span>أضف إلى Bag (Cash on Delivery)</span>
          </button>

          <a
            href="https://wa.me/{{ settings.whatsapp_number | default: '201065052442' }}?text=مرحباً%20فريق%20Ordon،%20أريد%20طلب%20{{ product.title | url_encode }}%20بسعر%20{{ product.price | money | url_encode }}"
            target="_blank"
            rel="noopener"
            class="w-full py-3.5 px-4 bg-[#14261d] hover:bg-[#1a382a] border border-emerald-500/30 text-emerald-400 text-xs font-bold rounded-lg flex items-center justify-center gap-2 transition-colors"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/>
            </svg>
            <span>طلب فوري ومباشر عبر WhatsApp (WhatsApp Order)</span>
          </a>
        </div>

        <!-- Trust Features Grid -->
        <div class="grid grid-cols-2 gap-3 pt-6 border-t border-slate-800 text-xs text-slate-300">
          <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800/80 flex items-center gap-2.5">
            <span class="text-sky-400 text-base">📦</span>
            <div>
              <div class="font-bold">معاينة قبل الدفع</div>
              <div class="text-[10px] text-slate-400">افتح وقيس مع المندوب</div>
            </div>
          </div>
          <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800/80 flex items-center gap-2.5">
            <span class="text-sky-400 text-base">⚡</span>
            <div>
              <div class="font-bold">شحن 24-48 ساعة</div>
              <div class="text-[10px] text-slate-400">Tanta، الدلتا، والقاهرة</div>
            </div>
          </div>
          <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800/80 flex items-center gap-2.5">
            <span class="text-sky-400 text-base">🔄</span>
            <div>
              <div class="font-bold">استبدال مقاس فوري</div>
              <div class="text-[10px] text-slate-400">خلال 48 ساعة فقط</div>
            </div>
          </div>
          <div class="p-3 rounded-lg bg-slate-900/60 border border-slate-800/80 flex items-center gap-2.5">
            <span class="text-sky-400 text-base">📍</span>
            <div>
              <div class="font-bold">متاح في 3 فروع</div>
              <div class="text-[10px] text-slate-400">Tanta / El-Mahalla / Kafr El-Sheikh</div>
            </div>
          </div>
        </div>

        <!-- Description Accordion -->
        <div class="pt-6 border-t border-slate-800 space-y-3">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono">تفاصيل القطعة والخامة:</h3>
          <div class="text-xs text-slate-300 leading-relaxed space-y-2">
            {{ product.description | default: '<p>قطعة شتوية مصممة بأعلى معايير الستريت وير: قطن مصري 100% ميلتون ثقيل مبطن من الداخل بنعومة فائقة، مع أكتاف ساقطة وقَصّة بوكسي واسعة تمنحك إطلالة فريدة ومقاومة عالية لبرودة الشتاء.</p>' }}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
