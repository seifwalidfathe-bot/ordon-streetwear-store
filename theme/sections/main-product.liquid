{%- comment -%}
  ORDON EGYPT — Main Product Template Section
  High-conversion product page tailored for Egyptian streetwear
{%- endcomment -%}

<section class="py-12 bg-white text-[#111111] min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-[#777777] font-mono mb-8" aria-label="Breadcrumb Navigation">
      <a href="/" class="hover:text-black transition-colors">HOME</a>
      <span>/</span>
      <a href="/collections/all" class="hover:text-black transition-colors">COLLECTIONS</a>
      <span>/</span>
      <span class="text-black font-bold uppercase">{{ product.title }}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Media Gallery (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="rounded overflow-hidden border border-[#e5e5e5] bg-[#f7f7f7] aspect-[3/4] relative group">
          {%- if product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 1200 }}"
              alt="{{ product.title | escape }}"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              id="main-product-image"
              loading="eager"
            >
          {%- else -%}
            <div class="w-full h-full flex items-center justify-center text-[#777777] font-mono">
              ORDON STREETWEAR
            </div>
          {%- endif -%}

          <div class="absolute top-4 left-4 flex flex-col gap-1.5 z-10">
            <span class="bg-black text-white text-[10px] font-mono font-bold uppercase px-2.5 py-1 rounded">WINTER 2026 // DROP 04</span>
            <span class="bg-white/90 backdrop-blur-sm text-black border border-[#e5e5e5] text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded">
              {{ product.type | default: '420 GSM FLEECE' }}
            </span>
          </div>
        </div>

        {%- if product.media.size > 1 -%}
          <div class="grid grid-cols-4 gap-3">
            {%- for media in product.media limit: 4 -%}
              <button
                type="button"
                class="rounded border border-[#e5e5e5] hover:border-black aspect-square overflow-hidden transition-all bg-[#f7f7f7] min-h-[44px]"
                onclick="document.getElementById('main-product-image').src='{{ media | image_url: width: 1200 }}'"
                aria-label="Product thumbnail {{ forloop.index }}"
              >
                <img src="{{ media | image_url: width: 250 }}" alt="{{ product.title | escape }} thumbnail" class="w-full h-full object-cover" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Micro Feature Badges -->
        <div class="grid grid-cols-3 gap-2 pt-2 text-center text-xs font-mono">
          <div class="p-3 bg-[#f7f7f7] border border-[#e5e5e5] rounded">
            <div class="font-bold text-[#111111]">100% COMBED</div>
            <div class="text-[10px] text-[#777777] mt-0.5">Egyptian Cotton</div>
          </div>
          <div class="p-3 bg-[#f7f7f7] border border-[#e5e5e5] rounded">
            <div class="font-bold text-[#111111]">TRY BEFORE PAY</div>
            <div class="text-[10px] text-[#777777] mt-0.5">Open-Box Inspection</div>
          </div>
          <div class="p-3 bg-[#f7f7f7] border border-[#e5e5e5] rounded">
            <div class="font-bold text-[#111111]">LAW 181/2018</div>
            <div class="text-[10px] text-[#777777] mt-0.5">14-Day Free Returns</div>
          </div>
        </div>
      </div>

      <!-- Product Buy Column (5 cols) -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        <div>
          <div class="flex items-center justify-between text-xs font-mono mb-2 border-b border-[#e5e5e5] pb-2">
            <span class="text-[#777777] uppercase font-bold">{{ product.type | default: 'HEAVYWEIGHT STREETWEAR' }}</span>
            <span class="text-emerald-600 font-bold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              IN STOCK (IMMEDIATE DISPATCH)
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-black text-[#111111] uppercase tracking-tight">
            {{ product.title }}
          </h1>

          <!-- Price Display -->
          <div class="mt-3 flex items-baseline gap-3">
            <span class="text-2xl font-mono font-black text-[#111111]">
              {{ product.price | money }}
            </span>
            {%- if product.compare_at_price > product.price -%}
              <span class="text-sm font-mono text-[#999999] line-through">
                {{ product.compare_at_price | money }}
              </span>
              <span class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-mono font-bold px-2 py-0.5 rounded">
                SAVE {{ product.compare_at_price | minus: product.price | money }}
              </span>
            {%- endif -%}
          </div>
          <div class="text-xs text-[#777777] mt-1 font-mono">Tax inclusive • Nationwide Cash on Delivery with open package inspection</div>
        </div>

        <!-- Description -->
        <div class="text-sm text-[#444444] leading-relaxed">
          {{ product.description | default: '<p>Engineered from custom-milled heavyweight combed fleece, built for structured street drape and long-lasting thermal comfort during winter months in Egypt. Designed with an exaggerated drop-shoulder silhouette and reinforced ribbed hems.</p>' }}
        </div>

        <!-- Size Selector -->
        <div class="space-y-2 pt-2 border-t border-[#e5e5e5]">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="font-bold text-[#111111] uppercase">SELECT SIZE:</span>
            <button type="button" onclick="openSizeModal()" class="text-neutral-600 hover:text-black underline font-bold flex items-center gap-1 min-h-[36px]">
              SIZE GUIDE (CM / KG) &rarr;
            </button>
          </div>

          <div class="grid grid-cols-4 gap-2">
            <button type="button" class="py-2.5 text-xs font-mono font-bold border border-[#e5e5e5] rounded hover:border-black min-h-[44px]">M</button>
            <button type="button" class="py-2.5 text-xs font-mono font-bold border border-black bg-black text-white rounded min-h-[44px]">L</button>
            <button type="button" class="py-2.5 text-xs font-mono font-bold border border-[#e5e5e5] rounded hover:border-black min-h-[44px]">XL</button>
            <button type="button" class="py-2.5 text-xs font-mono font-bold border border-[#e5e5e5] rounded hover:border-black min-h-[44px]">2XL</button>
          </div>
          <p class="text-[11px] text-[#555555] font-mono pt-1">
            Boxy Oversized Cut: Take your standard size for street drape, or size down for standard fitted look.
          </p>
        </div>

        <!-- Add to Cart & Fast Checkout CTAs -->
        <div class="space-y-3 pt-2">
          <button
            type="button"
            class="w-full py-3.5 px-6 bg-black text-white hover:bg-neutral-800 transition-colors text-xs font-mono font-bold uppercase tracking-wider rounded min-h-[48px] flex items-center justify-center gap-2"
            data-quick-add
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ product.price | divided_by: 100.0 }}"
            data-product-image="{{ product.featured_media | image_url: width: 250 }}"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span>+ ADD TO BAG (CASH ON DELIVERY)</span>
          </button>

          <a
            href="https://wa.me/{{ settings.whatsapp_number | default: '201068884978' }}?text=Hello%20ORDON%20Egypt!%20I%20would%20like%20to%20order%20{{ product.title | url_encode }}%20for%20{{ product.price | money | url_encode }}%20with%20Cash%20on%20Delivery%20inspection."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 px-6 bg-[#25D366] text-white hover:bg-[#20ba5a] transition-colors text-xs font-mono font-bold uppercase tracking-wider rounded min-h-[48px] flex items-center justify-center gap-2"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>⚡ 1-CLICK ORDER VIA WHATSAPP</span>
          </a>
        </div>

        <!-- Trust Features Grid -->
        <div class="border border-[#e5e5e5] rounded p-4 space-y-2.5 text-xs font-mono bg-[#fafafa]">
          <div class="flex items-start gap-2.5">
            <span class="text-black font-bold">🚚</span>
            <div>
              <span class="font-bold text-[#111111]">Rapid Delivery:</span>
              <span class="text-[#555555]"> Cairo & Giza in 24–48 hours. Delta, Alex & Canal in 2–3 days. Upper Egypt in 3–4 days.</span>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-black font-bold">👁️</span>
            <div>
              <span class="font-bold text-[#111111]">Try-On Inspection:</span>
              <span class="text-[#555555]"> You inspect the items and test the fit with the courier before paying cash.</span>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-black font-bold">🛡️</span>
            <div>
              <span class="font-bold text-[#111111]">Legal Consumer Protection:</span>
              <span class="text-[#555555]"> 14-day exchange or refund under Egyptian Law 181/2018. 30 days for factory flaws.</span>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-black font-bold">📍</span>
            <div>
              <span class="font-bold text-[#111111]">Physical Store Returns:</span>
              <span class="text-[#555555]"> Exchanges accepted at Nasr City, New Cairo, and Dokki branches.</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
