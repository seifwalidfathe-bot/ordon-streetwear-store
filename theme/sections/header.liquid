{%- comment -%}
  ORDON EGYPT — Header Section (Responsive Minimalist Ozar Streetwear)
{%- endcomment -%}

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-[#e5e5e5] transition-all" id="shopify-section-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-2 sm:gap-4">
    
    <!-- Right (Start in RTL): Mobile Menu Toggle + Desktop Nav -->
    <div class="flex items-center gap-2 lg:gap-6 flex-shrink-0">
      <button
        type="button"
        class="lg:hidden p-2 text-[#111111] hover:text-[#777777] transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center -mr-2"
        data-menu-drawer-toggle
        aria-label="القائمة Home"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>

      <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-xs font-bold uppercase tracking-wider text-[#111111]">
        <a href="/collections/winter" class="hover:text-neutral-500 transition-colors py-2">THE DROP</a>
        <a href="/#reels" class="hover:text-neutral-500 transition-colors py-2">REELS // FIT</a>
        <a href="/#lookbook" class="hover:text-neutral-500 transition-colors py-2">LOOKBOOK</a>
        <button type="button" data-branches-trigger class="hover:text-neutral-500 transition-colors uppercase py-2">BRANCHES (3)</button>
        <button type="button" data-size-trigger class="hover:text-neutral-500 transition-colors uppercase py-2">SIZE GUIDE</button>
        <button type="button" data-grc-trigger class="hover:text-neutral-500 transition-colors uppercase text-[11px] font-mono text-neutral-500 py-2">CONSUMER RIGHTS</button>
      </nav>
    </div>

    <!-- Center: Pure Typographic Brand Identity (Zero Logo Icon) -->
    <div class="flex-grow flex items-center justify-center text-center px-2">
      <a href="/" class="inline-flex items-baseline py-2 group select-none" aria-label="ORDON EGYPT Homepage">
        <span class="font-black text-xl sm:text-2xl lg:text-2xl tracking-[0.22em] text-[#111111] group-hover:opacity-80 transition-opacity">ORDON</span><span class="text-xs text-[#777777] font-semibold tracking-normal mr-1">.EGY</span>
      </a>
    </div>

    <!-- Left (End in RTL): Action Icons -->
    <div class="flex items-center gap-1 sm:gap-2 lg:gap-3 flex-shrink-0">
      <!-- Search Trigger -->
      <button
        type="button"
        data-search-trigger
        class="p-2 text-[#111111] hover:text-[#777777] transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
        aria-label="Search"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>

      <!-- Instagram Link -->
      <a
        href="https://instagram.com/ordon.eg"
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded border border-[#e5e5e5] text-xs font-bold uppercase text-[#111111] hover:bg-[#111111] hover:text-white transition-colors"
        title="Instagram Account @ordon.eg"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        <span class="hidden xl:inline">@ORDON.EG</span>
      </a>

      <!-- Branches Trigger -->
      <button
        type="button"
        data-branches-trigger
        class="p-2 text-[#111111] hover:text-[#777777] transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
        title="Stores الرسمية"
        aria-label="Stores"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
      </button>

      <!-- Cart Bag Trigger -->
      <button
        type="button"
        data-cart-trigger
        class="relative p-2 text-[#111111] hover:text-[#777777] transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
        aria-label="Shopping Bag"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span class="cart-counter-badge absolute top-1.5 left-1.5 w-4 h-4 rounded-full bg-[#111111] text-white text-[9px] font-mono font-bold flex items-center justify-center">
          {{ cart.item_count }}
        </span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer for Shopify -->
<div id="shopify-menu-drawer" class="mobile-nav-overlay" data-menu-drawer-overlay></div>
<aside class="mobile-nav-sidebar" data-menu-drawer dir="ltr">
  <div class="p-4 border-b border-[#e5e5e5] flex items-center justify-between">
    <div class="flex items-baseline">
      <span class="font-black text-xl tracking-[0.2em] text-[#111111]">ORDON</span>
      <span class="text-xs text-[#777777] font-semibold mr-1">.EGY</span>
    </div>
    <button type="button" class="p-2 text-[#777777] hover:text-[#111111] min-w-[44px] min-h-[44px] flex items-center justify-center" data-menu-drawer-close aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  <div class="flex-grow overflow-y-auto p-4 space-y-2">
    <a href="/collections/winter" class="block p-3 rounded hover:bg-neutral-100 font-bold text-sm text-[#111111]">THE DROP (كولكشن الشتاء)</a>
    <a href="/collections/hoodies" class="block p-3 rounded hover:bg-neutral-100 font-bold text-sm text-[#111111]">Hoodies وبلوفرات</a>
    <a href="/collections/tees" class="block p-3 rounded hover:bg-neutral-100 font-bold text-sm text-[#111111]">Tees بوكسي</a>
    <a href="/collections/pants" class="block p-3 rounded hover:bg-neutral-100 font-bold text-sm text-[#111111]">Cargo وباجي Jeans</a>
    <button type="button" data-branches-trigger class="w-full text-right p-3 rounded hover:bg-neutral-100 font-bold text-sm text-[#111111]">Our Stores (Tanta • El-Mahalla • Kafr El-Sheikh)</button>
    <button type="button" data-size-trigger class="w-full text-right p-3 rounded hover:bg-neutral-100 font-bold text-sm text-[#111111]">دليل Sizeات 📐</button>
  </div>
  <div class="p-4 border-t border-[#e5e5e5] bg-[#fafafa] space-y-2">
    <a href="https://wa.me/201065052442" target="_blank" rel="noopener" class="w-full py-3 bg-emerald-600 text-white text-xs font-bold rounded flex items-center justify-center gap-2">
      <span>⚡ طلب فوري عبر WhatsApp</span>
    </a>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "shopify-section-header",
  "settings": []
}
{% endschema %}