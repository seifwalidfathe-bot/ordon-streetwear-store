{%- comment -%}
  ORDON EGYPT — Main Collection Section
  Heavyweight streetwear catalog layout
{%- endcomment -%}

<section class="py-12 bg-white min-h-screen text-[#111111]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-[#777777] font-mono mb-8" aria-label="Breadcrumb Navigation">
      <a href="/" class="hover:text-black transition-colors">HOME</a>
      <span>/</span>
      <span class="text-black font-bold uppercase">COLLECTIONS</span>
    </nav>

    <!-- Collection Header -->
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#f7f7f7] border border-[#e5e5e5] rounded text-xs font-mono font-bold uppercase tracking-wider mb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>WINTER 2026 // DROP 04</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-[#111111] uppercase tracking-tight">
        {{ collection.title | default: 'THE FULL DROP (CATALOG)' }}
      </h1>
      <p class="text-xs sm:text-sm text-[#555555] mt-2">
        {{ collection.description | default: '100% combed Egyptian cotton heavyweight drops. Engineered for structural drape and daily movement.' }}
      </p>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div class="col-span-full text-center py-20 text-[#777777] font-mono text-sm">
          No products currently available in this collection drop.
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
