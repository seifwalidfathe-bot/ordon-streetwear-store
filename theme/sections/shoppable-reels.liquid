{% schema %}
{
  "name": "Shoppable Reels",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "REELS & FIT CHECKS IN MOTION"
    }
  ],
  "presets": [
    {
      "name": "Shoppable Reels"
    }
  ]
}
{% endschema %}
