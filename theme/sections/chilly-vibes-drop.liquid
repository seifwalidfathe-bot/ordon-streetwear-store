{%- comment -%}
  ORDON EGYPT — Brand Editorial: IN MOTION & FABRIC CRAFT (Ozar Minimal Style)
{%- endcomment -%}

<section class="py-12 sm:py-20 bg-white border-b border-[#e5e5e5]" id="chilly-vibes-drop">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    <!-- Lookbook Shoot Visual -->
    <div class="lg:col-span-5">
      <div class="rounded-lg overflow-hidden border border-[#e5e5e5] bg-[#f7f7f7] aspect-[4/5] shadow-sm">
        <img src="{{ 'lookbook-model-full.jpg' | asset_url }}" alt="Lookbook Streetwear" class="w-full h-full object-cover" loading="lazy">
      </div>
    </div>

    <!-- Editorial Craft Copy -->
    <div class="lg:col-span-7 flex flex-col items-start text-right">
      <span class="text-[11px] font-mono uppercase tracking-wider text-[#777777] font-bold mb-2">
        THE ORDON EDIT // IN MOTION
      </span>
      <h2 class="text-3xl sm:text-4xl font-black uppercase text-[#111111] leading-tight">
        CRAFTED FOR EGYPTIAN STREETS.
      </h2>
      <p class="mt-4 text-sm sm:text-base text-[#555555] leading-relaxed">
        كل دروب بنشتغل عليه بيعدي بمراحل اختبار متكررة: قطن مصري نقي طويل التيلة، صباغة ثابتة لا تتأثر بالغسيل، وباترون بوكسي مريح يعطيك المظهر الأوفرسايز المظبوط بدون أي مبالغة.
      </p>

      <div class="mt-8 space-y-3 w-full max-w-xl">
        <div class="p-3.5 rounded border border-[#e5e5e5] bg-[#fafafa] flex items-center justify-between">
          <span class="text-xs font-bold text-[#111111]">100% قطن مصري طويل التيلة</span>
          <span class="text-[11px] font-mono text-[#777777]">PURE FABRIC</span>
        </div>
        <div class="p-3.5 rounded border border-[#e5e5e5] bg-[#fafafa] flex items-center justify-between">
          <span class="text-xs font-bold text-[#111111]">معالجة بري-شرينك وثبات ألوان مضمون</span>
          <span class="text-[11px] font-mono text-[#777777]">PRE-SHRUNK</span>
        </div>
        <div class="p-3.5 rounded border border-[#e5e5e5] bg-[#fafafa] flex items-center justify-between">
          <span class="text-xs font-bold text-[#111111]">معاينة وقياس مع المندوب قبل السداد</span>
          <span class="text-[11px] font-mono text-[#777777]">TRY ON FIRST</span>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Fabric & Craft",
  "tag": "section",
  "class": "section-fabric-craft",
  "settings": []
}
{% endschema %}
