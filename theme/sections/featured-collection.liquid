{%- comment -%}
  ORDON EGYPT — The Latest Drop / New Arrivals (Ozar Minimal Style)
{%- endcomment -%}

<section id="featured-collection" class="py-12 sm:py-20 bg-[#fafafa] border-b border-[#e5e5e5]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header & Filter Tabs -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <span class="text-[11px] font-mono uppercase tracking-wider text-[#777777] font-bold block mb-1">
          NEW ARRIVALS // WINTER 2026
        </span>
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#111111]">
          THE LATEST DROP
        </h2>
      </div>

      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
        <a href="/collections/all" class="cat-btn is-active">ALL</a>
        <a href="/collections/tees" class="cat-btn">TEES</a>
        <a href="/collections/hoodies" class="cat-btn">HOODIES & SWEATS</a>
        <a href="/collections/pants" class="cat-btn">PANTS</a>
      </div>
    </div>

    <!-- Product Grid: 2-Col Mobile, 4-Col Desktop -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
      
      <!-- Card 1: BORN TO BE ICONIC Tee -->
      <div class="product-card group">
        <div class="product-image-wrap">
          <img src="{{ 'product-iconic-tee.jpg' | asset_url }}" alt="BORN TO BE ICONIC Tee" loading="lazy">
          <div class="absolute top-2 right-2">
            <span class="badge-sale">NEW IN</span>
          </div>
        </div>
        <div class="p-3.5 flex flex-col justify-between flex-grow gap-2">
          <div>
            <div class="text-[10px] text-[#777777] font-mono uppercase">280 GSM • BOXY FIT</div>
            <h3 class="font-bold text-xs sm:text-sm text-[#111111] uppercase line-clamp-1 mt-0.5">
              BORN TO BE ICONIC TEE
            </h3>
          </div>
          <div class="pt-2 border-t border-[#e5e5e5] flex items-baseline justify-between">
            <div>
              <span class="font-mono font-black text-xs sm:text-sm text-[#111111]">LE 550.00 EGP</span>
              <span class="font-mono text-[11px] text-[#999999] line-through mr-1.5">LE 700.00</span>
            </div>
            <button
              type="button"
              data-quick-add
              data-product-title="BORN TO BE ICONIC TEE"
              data-product-price="550"
              data-product-image="{{ 'product-iconic-tee.jpg' | asset_url }}"
              class="px-2.5 py-1 bg-[#111111] hover:bg-[#333333] text-white text-xs font-bold rounded"
            >
              + أضف
            </button>
          </div>
        </div>
      </div>

      <!-- Card 2: CHILLY VIBES Hoodie -->
      <div class="product-card group">
        <div class="product-image-wrap">
          <img src="{{ 'product-chilly-hoodie.jpg' | asset_url }}" alt="CHILLY VIBES Heavy Hoodie" loading="lazy">
          <div class="absolute top-2 right-2">
            <span class="badge-sale">420 GSM</span>
          </div>
        </div>
        <div class="p-3.5 flex flex-col justify-between flex-grow gap-2">
          <div>
            <div class="text-[10px] text-[#777777] font-mono uppercase">HEAVYWEIGHT FLEECE</div>
            <h3 class="font-bold text-xs sm:text-sm text-[#111111] uppercase line-clamp-1 mt-0.5">
              CHILLY VIBES HOODIE
            </h3>
          </div>
          <div class="pt-2 border-t border-[#e5e5e5] flex items-baseline justify-between">
            <div>
              <span class="font-mono font-black text-xs sm:text-sm text-[#111111]">LE 890.00 EGP</span>
              <span class="font-mono text-[11px] text-[#999999] line-through mr-1.5">LE 1,100.00</span>
            </div>
            <button
              type="button"
              data-quick-add
              data-product-title="CHILLY VIBES HOODIE"
              data-product-price="890"
              data-product-image="{{ 'product-chilly-hoodie.jpg' | asset_url }}"
              class="px-2.5 py-1 bg-[#111111] hover:bg-[#333333] text-white text-xs font-bold rounded"
            >
              + أضف
            </button>
          </div>
        </div>
      </div>

      <!-- Card 3: RAW MINIMAL Crewneck -->
      <div class="product-card group">
        <div class="product-image-wrap">
          <img src="{{ 'product-terracotta-crewneck.jpg' | asset_url }}" alt="RAW MINIMAL Crewneck" loading="lazy">
          <div class="absolute top-2 right-2">
            <span class="badge-sale">380 GSM</span>
          </div>
        </div>
        <div class="p-3.5 flex flex-col justify-between flex-grow gap-2">
          <div>
            <div class="text-[10px] text-[#777777] font-mono uppercase">BRUSHED FLEECE</div>
            <h3 class="font-bold text-xs sm:text-sm text-[#111111] uppercase line-clamp-1 mt-0.5">
              RAW MINIMAL CREWNECK
            </h3>
          </div>
          <div class="pt-2 border-t border-[#e5e5e5] flex items-baseline justify-between">
            <div>
              <span class="font-mono font-black text-xs sm:text-sm text-[#111111]">LE 780.00 EGP</span>
              <span class="font-mono text-[11px] text-[#999999] line-through mr-1.5">LE 950.00</span>
            </div>
            <button
              type="button"
              data-quick-add
              data-product-title="RAW MINIMAL CREWNECK"
              data-product-price="780"
              data-product-image="{{ 'product-terracotta-crewneck.jpg' | asset_url }}"
              class="px-2.5 py-1 bg-[#111111] hover:bg-[#333333] text-white text-xs font-bold rounded"
            >
              + أضف
            </button>
          </div>
        </div>
      </div>

      <!-- Card 4: TACTICAL CARGO Street Trousers -->
      <div class="product-card group">
        <div class="product-image-wrap">
          <img src="{{ 'product-tactical-cargo.jpg' | asset_url }}" alt="TACTICAL CARGO Pants" loading="lazy">
          <div class="absolute top-2 right-2">
            <span class="badge-sale">WIDE LEG</span>
          </div>
        </div>
        <div class="p-3.5 flex flex-col justify-between flex-grow gap-2">
          <div>
            <div class="text-[10px] text-[#777777] font-mono uppercase">HEAVY COTTON TWILL</div>
            <h3 class="font-bold text-xs sm:text-sm text-[#111111] uppercase line-clamp-1 mt-0.5">
              TACTICAL CARGO PANTS
            </h3>
          </div>
          <div class="pt-2 border-t border-[#e5e5e5] flex items-baseline justify-between">
            <div>
              <span class="font-mono font-black text-xs sm:text-sm text-[#111111]">LE 850.00 EGP</span>
              <span class="font-mono text-[11px] text-[#999999] line-through mr-1.5">LE 1,050.00</span>
            </div>
            <button
              type="button"
              data-quick-add
              data-product-title="TACTICAL CARGO PANTS"
              data-product-price="850"
              data-product-image="{{ 'product-tactical-cargo.jpg' | asset_url }}"
              class="px-2.5 py-1 bg-[#111111] hover:bg-[#333333] text-white text-xs font-bold rounded"
            >
              + أضف
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": []
}
{% endschema %}
