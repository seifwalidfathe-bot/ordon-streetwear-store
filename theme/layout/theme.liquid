<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' or request.locale.iso_code == 'ar-EG' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#111111">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% render 'social-meta-tags' %}
  {% render 'structured-data-schema' %}

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.ORDON_CONFIG = {
      freeShippingThreshold: {{ settings.free_shipping_threshold | default: 2000 }},
      currency: '{{ shop.currency }}',
      moneyFormat: {{ shop.money_format | json }}
    };
  </script>
</head>

<body class="template-{{ template.name | handle }} bg-white text-[#111111] pb-20 md:pb-0 font-sans antialiased selection:bg-[#111111] selection:text-white">
  <a class="sr-only focus:not-sr-only focus:p-4 focus:bg-[#111111] focus:text-white" href="#MainContent">
    Skip to content
  </a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" class="focus:outline-none flex-grow" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}
  {% render 'quick-shop-drawer' %}
  {% render 'branches-modal' %}
  {% render 'size-guide-modal' %}
  {% render 'grc-modal' %}
  {% render 'privacy-toast' %}
  {% render 'mobile-tab-dock' %}

  <div id="ordon-cart-overlay" class="cart-drawer-overlay"></div>

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
